# Copy this file to `.env` and fill in real values.
# Do not commit `.env`. Set the same keys in Railway (backend) and Netlify (VITE_API_URL).

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
DISCORD_WEBHOOK_URL=
API_TOKEN=change-me
SCAN_INTERVAL_SECONDS=20
# html = backend crawls listing pages. extension = skip that loop; jobs arrive via POST /api/jobs/ingest.
SCAN_MODE=html
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Leave empty to use SQLite when Supabase is unset / placeholder. Set 0 to force Supabase.
JOB_SCANNER_LOCAL_STORE=0
# Calendar day used by the Sources "Found" column (resets at midnight).
SCANNER_TZ=Asia/Tokyo

# Dashboard only (leave empty locally — Vite proxies /api to 127.0.0.1:8000).
# On Netlify, set this at BUILD time to the Railway backend public URL (no trailing slash).
VITE_API_URL=
